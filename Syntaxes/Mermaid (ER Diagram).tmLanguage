			<key>match</key>
			<string>(?x)
((?=[a-zA-Z])[-\w]+) # Entity 1

(?:
	\s*
	# Cardinality configuration thingie
	(
		# Entity 1's cardinality
		(?: \|o   # Zero or one
		|   \|\| # Exactly one
		|   }o     # Zero or more
		|   }\|   # One or more
		)
		
		# Stroke style
		(?: --     # Solid
		| \.\.   # Dashed
		)
		
		# Entity 2's cardinality
		(?: o\|   # Zero or one
		| \|\|   # Exactly one
		| o{       # Zero or more
		| \|{     # One or more
		)
	)
	\s*
	((?=[a-zA-Z])[-\w]+) # Entity 2
	
	# Relationship label
	\s* (:) \s*
	(?: ("[^"]*")             # Quoted
	|   ((?=[a-zA-Z])[-\w]+) # Unquoted
	|   ((?:[^\s%]|%(?!%))+) # Invalid
	)?
)?</string>
