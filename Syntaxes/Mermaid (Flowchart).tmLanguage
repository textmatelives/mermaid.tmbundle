		<key>node-shape-double-circle</key>
		<dict>
			<key>begin</key>
			<string>\G(\({3})</string>
			<key>beginCaptures</key>
			<dict>
				<key>0</key>
				<dict>
					<key>name</key>
					<string>punctuation.definition.string.begin.mermaid</string>
				</dict>
				<key>1</key>
