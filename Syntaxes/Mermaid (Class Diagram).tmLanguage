		<key>relation</key>
		<dict>
			<key>begin</key>
			<string>(?x)
# First operand
(?:
	((?=[a-zA-Z])\w+)  # Name
	(?:\s+("[^"]*"))?  # Cardinality
	\s*
)?

# Link operator
(?:
	# (Possibly asymmetrical) two-way relation
	((?:[*o]|&lt;\|?)(?:--|\.\.)(?:[*o]|\|?&gt;))
	
	# One-way relations
	| (--\|&gt;     | &lt;\|--)      # Inheritance
	| (--\*      | \*--)       # Composition
	| (--o        | o--)         # Aggregation
	| (--&gt;        | &lt;--)         # Association
	| (\.{2}\|&gt; | &lt;\|\.{2})  # Realisation
	| (\.{2}&gt;    | &lt;\.{2})     # Dependency
	| (\.{2})                   # Link, dashed
	| (--)                       # Link, solid
)

# Second operand
(?:
	\s*
	(?:("[^"]*")\s+)?  # Cardinality
	((?=[a-zA-Z])\w+)  # Name
)?</string>
