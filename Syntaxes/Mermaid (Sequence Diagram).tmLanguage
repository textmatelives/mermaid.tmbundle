(
	(?=\S)
	(?:[^-+&gt;:,;\s]+|\s+(?!as(?:$|\s)))++
	(?:
		(?!--?[x\x29])
		(?:-*[^-+&gt;:,;\s]+|\s+(?!as(?:$|\s)))
	)*?
)
(?:\s+(as)(?=$|\s|;))?</string>
			<key>name</key>
