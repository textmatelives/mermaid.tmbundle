						</dict>
					</array>
				</dict>
				<dict>
					<key>applyEndPatternLast</key>
					<true/>
					<key>begin</key>
					<string>:</string>
					<key>beginCaptures</key>
					<dict>
						<key>0</key>
						<dict>
