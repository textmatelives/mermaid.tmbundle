									<key>patterns</key>
									<array>
										<dict>
											<key>include</key>
											<string>#string-innards</string>
										</dict>
									</array>
								</dict>
								<key>2</key>
								<dict>
									<key>name</key>
									<string>keyword.operator.assignment.mermaid</string>
								</dict>
								<key>3</key>
								<dict>
									<key>name</key>
									<string>punctuation.separator.link-spec.mermaid</string>
								</dict>
							</dict>
							<key>match</key>
							<string>\G\s*([^;@]*)\s*((@))</string>
							<key>name</key>
							<string>meta.link-text.mermaid</string>
						</dict>
						<dict>
							<key>begin</key>
							<string>(?:(?&lt;=@)|(?&lt;=:)\G)[ \t]*(?![^;]*@)</string>
							<key>contentName</key>
							<string>constant.other.reference.link.mermaid</string>
							<key>end</key>
							<string>(?=\s*(?:$|;))</string>
							<key>name</key>
							<string>meta.link-target.mermaid</string>
							<key>patterns</key>
							<array>
								<dict>
									<key>include</key>
									<string>#string-innards</string>
								</dict>
							</array>
						</dict>
					</array>
				</dict>
			</array>
		</dict>
		<key>message</key>
		<dict>
			<key>begin</key>
